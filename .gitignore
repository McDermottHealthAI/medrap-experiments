# Python build artifacts
__pycache__/
*.py[cod]
.venv/

# Experiment run artifacts -- large, machine-specific, and regenerated by the
# sbatch scripts. None of these are tracked today; this keeps `git add -A`
# from sweeping them in. (mimic_iv_smoke/data/ alone is ~7 GB.)
*/data/
*/outputs/
*/logs/
*/wandb/
cli.log
*/cli.log

# Per-run scratch: SLURM job-id handoff files and stray bench logs.
# Regenerated by run_all.sh / the sbatch scripts on every launch.
.probe_job
.priority_jobs
.k128_jobs
kbench_*.out
kbench_*.err
